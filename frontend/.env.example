# Base URL of the GRVTY API (include /api/v1, no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Public URL of this site — used for SEO / Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match the backend's shipping rules (PKR)
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=5000
NEXT_PUBLIC_SHIPPING_FEE=250
