NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/grvty for a local server)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/grvty?retryWrites=true&w=majority

# Long random string — e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed frontend origins (comma separated, no trailing slash)
CLIENT_URL=http://localhost:3000

# Shipping rules (PKR)
FREE_SHIPPING_THRESHOLD=5000
SHIPPING_FEE=250

# Accounts created by `npm run seed`
SEED_ADMIN_EMAIL=admin@grvty.store
SEED_ADMIN_PASSWORD=Admin12345
SEED_USER_EMAIL=demo@grvty.store
SEED_USER_PASSWORD=Demo12345
